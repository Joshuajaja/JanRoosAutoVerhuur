<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="JanRoosAutoVerhuur.Kaartje"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        x:Name="CardBorder"
        StrokeShape="RoundRectangle 16"
        BackgroundColor="#1E1E1E"
        Padding="10">

        <Grid RowDefinitions="*, Auto, Auto">

            <Border
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0"
                BackgroundColor="#333">

                <Image
                    Source="audi.png"
                    Aspect="AspectFill" />
            </Border>

            <Label
                Grid.Row="1"
                Text="{Binding DisplayName}"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="16"
                Margin="0,8,0,0"
                LineBreakMode="TailTruncation" />

            <Label
                Grid.Row="2"
                Text="{Binding Type}"
                TextColor="#CCCCCC"
                FontSize="14" />

        </Grid>
    </Border>
</ContentView>
